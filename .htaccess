# ==========================================================================
# iDispečink.cz — konfigurace pro Apache (běžný FTP hosting)
#
# Soubor nahrajte do kořene webu spolu s ostatními soubory. Pokud váš
# hosting Apache nepoužívá (nginx, Litespeed s vlastní konfigurací),
# soubor nic nerozbije — jen se ignoruje, a stejné věci si nastavte
# v administraci hostingu.
# ==========================================================================

# --- Chybová stránka ------------------------------------------------------
ErrorDocument 404 /404.html

# --- Výchozí dokument -----------------------------------------------------
DirectoryIndex index.html

# --- Kódování -------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Přesměrování na HTTPS a bez www --------------------------------------
# Zapněte, až budete mít na doméně funkční certifikát. Do té doby by
# přesměrování na HTTPS web znepřístupnilo.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://idispecink.cz/$1 [R=301,L]

  # RewriteCond %{HTTP_HOST} ^www\.idispecink\.cz$ [NC]
  # RewriteRule ^(.*)$ https://idispecink.cz/$1 [R=301,L]
</IfModule>

# --- Komprese -------------------------------------------------------------
<IfModule mod_deflate.c>
  # Novější Apache hlásí XML jako application/xml, starší jako text/xml —
  # uvedeny jsou oba, jinak by se sitemap.xml posílala nekomprimovaná.
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  # Novější Apache hlásí skripty jako text/javascript, starší jako
  # application/javascript — uvedeny jsou obě, jinak se komprese minula účinkem.
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache ----------------------------------------------------------------
# HTML se necachuje agresivně, aby se změny na webu projevily hned.
# Statická aktiva vydrží dlouho — při jejich změně změňte název souboru
# nebo připojte ?v=2 k odkazu.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# --- Bezpečnostní hlavičky ------------------------------------------------
<IfModule mod_headers.c>
  # Web je plně statický a vše načítá sám ze sebe: jediný skript je lokální
  # main.js, inline <script> je jen neexekuovaný JSON-LD (CSP ho neblokuje),
  # styly lokální + inline atributy style. Při přidání externího zdroje
  # (mapy, měření…) je nutné politiku rozšířit.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>

# --- Skrýt soubory, které na web nepatří ----------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
