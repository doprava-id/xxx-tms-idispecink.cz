# Přihlašovací údaje — nikdy necommitovat.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Provozní data. Exporty přeprav, reporty a objednávky obsahují osobní údaje
# zákazníků, dopravců i řidičů. Do repozitáře prezentačního webu nepatří.
*.xlsx
*.xlsm
*.csv
*.docx
/data/
/exports/
/logs/

# Provozní systém (aplikace/) — konfigurace a databáze.
# config.php nese přístup k databázi, data/ celou evidenci přeprav
# s osobními údaji zákazníků, dopravců i řidičů. Repozitář je veřejný.
/aplikace/config.php
/aplikace/data/*
!/aplikace/data/.htaccess

# Pomocné soubory při práci na webu
nahled-tmp.html
/undefined/

# Systém a editory
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
